<Window x:Class="BrioRecorder.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Brio Recorder"
        Icon="video_record_B_icon.ico"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="980">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition x:Name="RightPanelSpacerColumn" Width="12" />
            <ColumnDefinition x:Name="RecordedFilesColumnDefinition" Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,12"
                Padding="12"
                Background="#FFF8FAFC"
                BorderBrush="#FFD0D7DE"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="Camera" />
                <ComboBox x:Name="CameraComboBox"
                          Grid.Column="1"
                          Height="32"
                          VerticalAlignment="Center"
                          DisplayMemberPath="Name"
                          SelectionChanged="CameraComboBox_SelectionChanged" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="Quality" />
                <ComboBox x:Name="QualityComboBox"
                          Grid.Column="3"
                          Height="32"
                          VerticalAlignment="Center"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="QualityComboBox_SelectionChanged" />
                <Button x:Name="RefreshCamerasButton"
                        Grid.Column="4"
                        Width="90"
                        Height="32"
                        Margin="12,0,0,0"
                        Click="RefreshCamerasButton_Click"
                        Content="Refresh" />
                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="6"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Mode" />
                    <RadioButton x:Name="RegularRecordingRadioButton"
                                 Margin="16,0,0,0"
                                 VerticalAlignment="Center"
                                 GroupName="RecordingMode"
                                 IsChecked="True"
                                 Checked="RecordingModeRadioButton_Checked"
                                 Content="Regular" />
                    <RadioButton x:Name="LoopRecordingRadioButton"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 GroupName="RecordingMode"
                                 Checked="RecordingModeRadioButton_Checked"
                                 Content="Loop" />
                    <TextBlock Margin="20,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Keep" />
                    <ComboBox x:Name="LoopHoursComboBox"
                              Width="80"
                              Height="32"
                              VerticalAlignment="Center"
                              SelectionChanged="LoopHoursComboBox_SelectionChanged" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Text="hours" />
                </StackPanel>
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="6"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <Button x:Name="StartRecordingButton"
                            Width="140"
                            Height="32"
                            Click="StartRecordingButton_Click"
                            Content="Start Recording" />
                    <Button x:Name="StopRecordingButton"
                            Width="140"
                            Height="32"
                            Margin="12,0,0,0"
                            Click="StopRecordingButton_Click"
                            Content="Stop Recording" />
                    <Button x:Name="OpenFolderButton"
                            Width="110"
                            Height="32"
                            Margin="12,0,0,0"
                            Click="OpenFolderButton_Click"
                            Content="Open Folder" />
                    <Button x:Name="ChangeFolderButton"
                            Width="120"
                            Height="32"
                            Margin="12,0,0,0"
                            Click="ChangeFolderButton_Click"
                            Content="Change Folder" />
                    <Button x:Name="HelpButton"
                            Width="80"
                            Height="32"
                            Margin="12,0,0,0"
                            Click="HelpButton_Click"
                            Content="Help" />
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="8"
                    Background="#FF0F172A"
                    BorderBrush="#FFD0D7DE"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="PreviewPlaceholderTextBlock"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="#FFE2E8F0"
                               Text="Camera preview will appear here" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="12"
                    Background="#FFF8FAFC"
                    BorderBrush="#FFD0D7DE"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Details" />
                        <Button x:Name="ToggleDetailsPanelButton"
                                Grid.Column="1"
                                Width="28"
                                Height="24"
                                Padding="0"
                                Click="ToggleDetailsPanelButton_Click"
                                Content="&#9650;" />
                    </Grid>

                    <Grid x:Name="DetailsPanelContent"
                          Grid.Row="1"
                          Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Recording folder" />
                        <TextBlock x:Name="RecordingFolderTextBlock"
                                   Grid.Row="1"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3"
                                   Margin="0,10,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Selected quality" />
                        <TextBlock x:Name="RecordingQualityTextBlock"
                                   Grid.Row="4"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5"
                                   Margin="0,10,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Recording mode" />
                        <TextBlock x:Name="RecordingModeTextBlock"
                                   Grid.Row="6"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7"
                                   Margin="0,10,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Loop retention" />
                        <TextBlock x:Name="LoopRetentionTextBlock"
                                   Grid.Row="8"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="9"
                                   Margin="0,10,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Estimated size" />
                        <TextBlock x:Name="EstimatedSizeTextBlock"
                                   Grid.Row="10"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="11"
                                   Margin="0,10,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Recording time" />
                        <TextBlock x:Name="RecordingTimeTextBlock"
                                   Grid.Row="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Grid.Column="2"
                Padding="12"
                Background="#FFF8FAFC"
                BorderBrush="#FFD0D7DE"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Recorded Files" />
                    <Button x:Name="ToggleRecordedFilesPanelButton"
                            Grid.Column="1"
                            Width="28"
                            Height="24"
                            Padding="0"
                            Click="ToggleRecordedFilesPanelButton_Click"
                            Content="&#9668;" />
                </Grid>

                <Grid x:Name="RecordedFilesContent"
                      Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="SelectAllRecordingsCheckBox"
                              Margin="0,10,0,0"
                              VerticalAlignment="Center"
                              Content="Select All"
                              Checked="SelectAllRecordingsCheckBox_Changed"
                              Unchecked="SelectAllRecordingsCheckBox_Changed" />

                    <Grid Grid.Row="1"
                          Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlaySelectedButton"
                                Height="32"
                                Margin="0,0,6,0"
                                Click="PlaySelectedButton_Click"
                                Content="Play Selected" />
                        <Button x:Name="DeleteSelectedButton"
                                Grid.Column="1"
                                Height="32"
                                Margin="6,0,6,0"
                                Click="DeleteSelectedButton_Click"
                                Content="Delete Selected" />
                        <Button x:Name="DeleteCheckedButton"
                                Grid.Column="2"
                                Height="32"
                                Margin="6,0,0,0"
                                Click="DeleteCheckedButton_Click"
                                Content="Delete Checked" />
                    </Grid>

                    <TextBlock x:Name="SelectedFileTextBlock"
                               Grid.Row="2"
                               Margin="0,6,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF475569"
                               TextTrimming="CharacterEllipsis" />

                    <ListBox x:Name="RecordingsListBox"
                             Grid.Row="3"
                             Margin="0,10,0,0"
                             MouseDoubleClick="RecordingsListBox_MouseDoubleClick"
                             SelectionChanged="RecordingsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Margin="0,2,8,0"
                                              VerticalAlignment="Top"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Checked="RecordedFileCheckBox_Changed"
                                              Unchecked="RecordedFileCheckBox_Changed" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12"
                                                   Foreground="#FF475569"
                                                   Text="{Binding FilePath}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>


